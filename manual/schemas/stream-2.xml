  </message>
  <message name="InstrumentListingRecordCount" id="47" blockLength="8" description="openmdta:entity:INSTRUMENT">
    <field name="count" id="1" type="uint64" offset="0"/>
  </message>

  <!-- Each Catalog subfield is the ISO effective date (YYYY-MM-DD). A bundle
       allows several independently sourced economic events on the same day. -->
  <message name="CorporateActions" id="48" blockLength="0" description="openmdta:entity:INSTRUMENT openmdta:multiple">
    <group name="events" id="1" dimensionType="groupSizeEncoding" blockLength="26">
      <field name="kind" id="1" type="CorporateActionKind" offset="0"/>
      <field name="status" id="2" type="CorporateEventStatus" offset="1"/>
      <!-- For a split, newShares / oldShares is the share-count ratio. Both
           are absent for action kinds that have no meaningful ratio. -->
      <field name="newShares" id="3" type="uint64" offset="2" presence="optional" nullValue="18446744073709551615"/>
      <field name="oldShares" id="4" type="uint64" offset="10" presence="optional" nullValue="18446744073709551615"/>
      <field name="announcementDay" id="5" type="uint32" offset="18" presence="optional" nullValue="4294967295"/>
      <field name="recordDay" id="6" type="uint32" offset="22" presence="optional" nullValue="4294967295"/>
      <data name="eventId" id="7" type="varDataEncoding"/>
    </group>
  </message>

  <!-- Each Catalog subfield is the ISO ex-date (YYYY-MM-DD). Monetary values
       are deliberately mandatory: an amount-less notice is not a distribution
       suitable for adjustment or consolidation. -->
  <message name="Distributions" id="49" blockLength="0" description="openmdta:entity:INSTRUMENT openmdta:multiple">
    <group name="events" id="1" dimensionType="groupSizeEncoding" blockLength="19">
      <field name="kind" id="1" type="DistributionKind" offset="0"/>
      <field name="status" id="2" type="CorporateEventStatus" offset="1"/>
      <field name="amount" id="3" type="DecimalEncoding" offset="2"/>
      <field name="recordDay" id="4" type="uint32" offset="11" presence="optional" nullValue="4294967295"/>
      <field name="paymentDay" id="5" type="uint32" offset="15" presence="optional" nullValue="4294967295"/>
      <data name="currency" id="6" type="varDataEncoding"/>
      <data name="eventId" id="7" type="varDataEncoding"/>
    </group>
  </message>
  <!-- Membership and its effective date form one atomic, licensed field.
       Index variants are separate instruments, never aliases of the list. -->
  <message name="ListDefinition" id="50" blockLength="0" description="openmdta:entity:LIST">
    <group name="members" id="1" dimensionType="groupSizeEncoding" blockLength="0">
      <data name="identifier" id="1" type="varDataEncoding" description="openmdta:reference:INSTRUMENT"/>
    </group>
    <group name="variants" id="2" dimensionType="groupSizeEncoding" blockLength="0">
      <data name="returnType" id="1" type="varDataEncoding"/>
      <data name="currency" id="2" type="varDataEncoding"/>
      <data name="identifier" id="3" type="varDataEncoding" description="openmdta:reference:INSTRUMENT"/>
    </group>
    <data name="code" id="3" type="varDataEncoding"/>
    <data name="name" id="4" type="varDataEncoding"/>
    <data name="description" id="5" type="varDataEncoding"/>
    <data name="kind" id="6" type="varDataEncoding"/>
    <data name="memberDimension" id="7" type="varDataEncoding"/>
    <data name="validAt" id="8" type="varDataEncoding"/>
  </message>
</messageSchema>
