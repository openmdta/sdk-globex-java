<?xml version="1.0" encoding="UTF-8"?>
<messageSchema package="market.internal" id="100" byteOrder="littleEndian" version="3">
  <types>
    <composite name="messageHeader">
      <type name="blockLength" primitiveType="uint16"/>
      <type name="templateId" primitiveType="uint16"/>
      <type name="schemaId" primitiveType="uint16"/>
      <type name="version" primitiveType="uint16"/>
    </composite>
    <composite name="varDataEncoding">
      <type name="length" primitiveType="uint32"/>
      <type name="varData" primitiveType="uint8" length="0"/>
    </composite>
    <composite name="DecimalEncoding" semanticType="Decimal">
      <type name="mantissa" primitiveType="int64"/>
      <type name="exponent" primitiveType="int8"/>
    </composite>
    <!-- An optional quote composite is absent when its first Decimal has the
         standard SBE null image. Remaining bytes are deterministic zeroes. -->
    <composite name="QuoteLevel">
      <ref name="price" type="DecimalEncoding"/>
      <type name="size" primitiveType="uint32"/>
    </composite>
    <composite name="QuoteSideCandle">
      <ref name="open" type="DecimalEncoding"/>
      <ref name="high" type="DecimalEncoding"/>
      <ref name="low" type="DecimalEncoding"/>
      <ref name="close" type="DecimalEncoding"/>
      <type name="closingSize" primitiveType="uint32"/>
    </composite>
    <enum name="ListingActivity" encodingType="uint8">
      <validValue name="Active">0</validValue>
      <validValue name="Inactive">1</validValue>
    </enum>
    <enum name="CorporateActionKind" encodingType="uint8">
      <validValue name="Unknown">0</validValue>
      <validValue name="ShareSplit">1</validValue>
      <validValue name="StockDividend">2</validValue>
      <validValue name="RightsIssue">3</validValue>
      <validValue name="SpinOff">4</validValue>
      <validValue name="Merger">5</validValue>
      <validValue name="Other">254</validValue>
    </enum>
    <enum name="CorporateEventStatus" encodingType="uint8">
      <validValue name="Unknown">0</validValue>
      <validValue name="Announced">1</validValue>
      <validValue name="Confirmed">2</validValue>
      <validValue name="Cancelled">3</validValue>
    </enum>
    <enum name="DistributionKind" encodingType="uint8">
      <validValue name="Unknown">0</validValue>
      <validValue name="Dividend">1</validValue>
      <validValue name="Interest">2</validValue>
      <validValue name="ReturnOfCapital">3</validValue>
      <validValue name="CapitalGain">4</validValue>
      <validValue name="Other">254</validValue>
    </enum>
    <composite name="groupSizeEncoding">
      <type name="blockLength" primitiveType="uint16"/>
      <type name="numInGroup" primitiveType="uint16"/>
    </composite>
  </types>

  <message name="BidAsk" id="10" blockLength="27">
    <field name="bid" id="1" type="QuoteLevel" offset="0" presence="optional"/>
    <field name="ask" id="2" type="QuoteLevel" offset="13" presence="optional"/>
    <field name="quoteCondition" id="3" type="uint8" offset="26" presence="optional" nullValue="255"/>
  </message>

  <message name="Trade" id="11" blockLength="18">
    <field name="price" id="1" type="DecimalEncoding" offset="0"/>
    <field name="volume" id="2" type="uint64" offset="9"/>
    <field name="saleConditionFlags" id="3" type="uint8" offset="17" presence="optional" nullValue="255"/>
  </message>

  <!-- Candles are end-labelled: the represented interval is
       [bucketEnd - cadence, bucketEnd). Cadence belongs to the field/model,
       not every persisted value. -->
  <message name="BidAskCandle" id="12" blockLength="89">
    <field name="bid" id="1" type="QuoteSideCandle" offset="0" presence="optional"/>
    <field name="ask" id="2" type="QuoteSideCandle" offset="40" presence="optional"/>
    <field name="quoteCount" id="3" type="uint64" offset="80"/>
    <field name="closingQuoteCondition" id="4" type="uint8" offset="88" presence="optional" nullValue="255"/>
  </message>

  <message name="TradeCandle" id="13" blockLength="52">
    <field name="open" id="1" type="DecimalEncoding" offset="0"/>
    <field name="high" id="2" type="DecimalEncoding" offset="9"/>
    <field name="low" id="3" type="DecimalEncoding" offset="18"/>
    <field name="close" id="4" type="DecimalEncoding" offset="27"/>
    <field name="totalVolume" id="5" type="uint64" offset="36"/>
    <field name="tradeCount" id="6" type="uint64" offset="44"/>
  </message>

  <!-- Daily values are New York calendar days. The block is 53 fixed bytes
       (61 bytes including its SBE header) and remains separate per side/kind. -->
  <message name="BidDailyOhlc" id="14" blockLength="53">
    <field name="open" id="1" type="DecimalEncoding" offset="0"/>
    <field name="high" id="2" type="DecimalEncoding" offset="9"/>
    <field name="low" id="3" type="DecimalEncoding" offset="18"/>
    <field name="closeLast" id="4" type="DecimalEncoding" offset="27"/>
    <field name="closePrevious" id="5" type="DecimalEncoding" offset="36"/>
    <field name="day" id="6" type="uint32" offset="45"/>
    <field name="flags" id="7" type="uint32" offset="49"/>
  </message>

  <message name="AskDailyOhlc" id="15" blockLength="53">
    <field name="open" id="1" type="DecimalEncoding" offset="0"/>
    <field name="high" id="2" type="DecimalEncoding" offset="9"/>
    <field name="low" id="3" type="DecimalEncoding" offset="18"/>
    <field name="closeLast" id="4" type="DecimalEncoding" offset="27"/>
    <field name="closePrevious" id="5" type="DecimalEncoding" offset="36"/>
    <field name="day" id="6" type="uint32" offset="45"/>
    <field name="flags" id="7" type="uint32" offset="49"/>
  </message>

  <message name="TradeDailyOhlc" id="16" blockLength="53">
    <field name="open" id="1" type="DecimalEncoding" offset="0"/>
    <field name="high" id="2" type="DecimalEncoding" offset="9"/>
    <field name="low" id="3" type="DecimalEncoding" offset="18"/>
    <field name="closeLast" id="4" type="DecimalEncoding" offset="27"/>
    <field name="closePrevious" id="5" type="DecimalEncoding" offset="36"/>
    <field name="day" id="6" type="uint32" offset="45"/>
    <field name="flags" id="7" type="uint32" offset="49"/>
  </message>

  <message name="InstrumentDefinition" id="20" blockLength="1">
    <field name="activity" id="1" type="ListingActivity" offset="0"/>
    <data name="instrument" id="2" type="varDataEncoding"/>
    <data name="isin" id="3" type="varDataEncoding"/>
    <data name="venue" id="4" type="varDataEncoding"/>
    <data name="currency" id="5" type="varDataEncoding"/>
    <data name="name" id="6" type="varDataEncoding"/>
  </message>

  <message name="Listing" id="30" blockLength="0">
    <data name="source" id="1" type="varDataEncoding"/>
    <data name="venue" id="2" type="varDataEncoding"/>
    <data name="instrument" id="3" type="varDataEncoding"/>
    <data name="currency" id="4" type="varDataEncoding"/>
    <data name="isin" id="5" type="varDataEncoding"/>
  </message>

  <message name="CompanyProfile" id="31" blockLength="1">
    <field name="hasLei" id="1" type="uint8" offset="0"/>
    <data name="canonicalName" id="2" type="varDataEncoding"/>
    <data name="lei" id="3" type="varDataEncoding"/>
  </message>

  <message name="CompanyAddress" id="32" blockLength="0">
    <data name="language" id="1" type="varDataEncoding"/>
    <data name="firstAddressLine" id="2" type="varDataEncoding"/>
    <data name="additionalAddressLine1" id="3" type="varDataEncoding"/>
    <data name="additionalAddressLine2" id="4" type="varDataEncoding"/>
    <data name="additionalAddressLine3" id="5" type="varDataEncoding"/>
    <data name="addressNumber" id="6" type="varDataEncoding"/>
    <data name="addressNumberWithinBuilding" id="7" type="varDataEncoding"/>
    <data name="mailRouting" id="8" type="varDataEncoding"/>
    <data name="city" id="9" type="varDataEncoding"/>
    <data name="region" id="10" type="varDataEncoding"/>
    <data name="country" id="11" type="varDataEncoding"/>
    <data name="postalCode" id="12" type="varDataEncoding"/>
  </message>

  <message name="InstrumentIssuer" id="33" blockLength="0">
    <data name="lei" id="1" type="varDataEncoding"/>
  </message>

  <message name="BasicMasterdata" id="34" blockLength="0">
    <data name="name" id="1" type="varDataEncoding"/>
  </message>

  <message name="InstrumentNames" id="35" blockLength="0" description="openmdta:entity:INSTRUMENT">
    <group name="localized" id="1" dimensionType="groupSizeEncoding" blockLength="0">
      <data name="language" id="1" type="varDataEncoding"/>
      <data name="long" id="2" type="varDataEncoding"/>
      <data name="short" id="3" type="varDataEncoding"/>
    </group>
    <data name="long" id="2" type="varDataEncoding"/>
    <data name="short" id="3" type="varDataEncoding"/>
  </message>

  <message name="LegalEntityNames" id="36" blockLength="0" description="openmdta:entity:LEGAL_ENTITY">
    <group name="localized" id="1" dimensionType="groupSizeEncoding" blockLength="0">
      <data name="language" id="1" type="varDataEncoding"/>
      <data name="long" id="2" type="varDataEncoding"/>
      <data name="short" id="3" type="varDataEncoding"/>
    </group>
    <data name="long" id="2" type="varDataEncoding"/>
    <data name="short" id="3" type="varDataEncoding"/>
  </message>

  <message name="Classification" id="37" blockLength="0" description="openmdta:entity:INSTRUMENT openmdta:multiple">
    <data name="code" id="1" type="varDataEncoding"/>
    <data name="label" id="2" type="varDataEncoding"/>
  </message>

  <message name="ListingClassification" id="38" blockLength="0" description="openmdta:entity:LISTING openmdta:multiple">
    <data name="code" id="1" type="varDataEncoding"/>
    <data name="label" id="2" type="varDataEncoding"/>
  </message>

  <message name="ListingQuotation" id="39" blockLength="0" description="openmdta:entity:LISTING">
    <data name="currency" id="1" type="varDataEncoding"/>
    <data name="unit" id="2" type="varDataEncoding"/>
    <data name="decimalDigits" id="3" type="varDataEncoding"/>
