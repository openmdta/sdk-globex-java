  </message>

  <message name="ListingTickSchedule" id="45" blockLength="0" description="openmdta:entity:LISTING">
    <group name="tiers" id="1" dimensionType="groupSizeEncoding" blockLength="18">
      <field name="upperBound" id="1" type="DecimalEncoding" offset="0"/>
