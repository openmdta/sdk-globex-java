<?xml version="1.0" encoding="UTF-8"?>
<!-- MDToken v2. The codec is hand-written; header versions are exact, not ranges:
     the MDToken envelope header is (0, 1, 8, 1) and the claims header is (16, 2, 8, 3).
     The signature is Ed25519 over ASCII "OpenMDTA-MDToken-v2", one zero byte, then every
     envelope byte before the signature bytes, including the signature's uint32 length. -->
<messageSchema package="openmdta.data.auth" id="8" version="3" byteOrder="littleEndian">
  <types>
    <composite name="messageHeader">
      <type name="blockLength" primitiveType="uint16"/>
      <type name="templateId" primitiveType="uint16"/>
      <type name="schemaId" primitiveType="uint16"/>
      <type name="version" primitiveType="uint16"/>
    </composite>
    <composite name="groupSizeEncoding">
      <type name="blockLength" primitiveType="uint16"/>
      <type name="numInGroup" primitiveType="uint16"/>
    </composite>
    <composite name="varDataEncoding">
      <type name="length" primitiveType="uint32"/>
      <type name="varData" primitiveType="uint8" length="0"/>
    </composite>
    <!-- UNTIMED with package "*" is the only wildcard; with NAMESPACE:LICENSE it is an untimed package. -->
    <enum name="Quality" encodingType="uint8">
      <validValue name="UNTIMED">0</validValue>
      <validValue name="RT">1</validValue>
      <validValue name="DL">2</validValue>
      <validValue name="EOD">3</validValue>
    </enum>
  </types>
  <message name="MDToken" id="1" blockLength="0">
    <data name="clientId" id="1" type="varDataEncoding"/>
    <data name="claimsZlib" id="2" type="varDataEncoding"/>
    <!-- Exactly 64 bytes. -->
    <data name="signature" id="3" type="varDataEncoding"/>
  </message>
  <message name="MDTokenClaims" id="2" blockLength="16">
    <field name="issuedAt" id="1" type="int64"/>
    <field name="expiresAt" id="2" type="int64"/>
    <group name="grants" id="3" dimensionType="groupSizeEncoding" blockLength="1">
      <field name="quality" id="4" type="Quality"/>
      <data name="package" id="5" type="varDataEncoding"/>
    </group>
    <!-- Always present; an empty group allows only requests without an Origin header. -->
    <group name="allowedOrigins" id="7" dimensionType="groupSizeEncoding" blockLength="0">
      <data name="origin" id="8" type="varDataEncoding"/>
    </group>
    <data name="audience" id="6" type="varDataEncoding"/>
    <!-- Empty when absent. Otherwise a length-prefixed UTF-8 bucket ID, then uint64
         capacity and uint64 refill per second, both in millionths of a token. -->
    <data name="rateLimit" id="9" type="varDataEncoding"/>
  </message>
</messageSchema>
